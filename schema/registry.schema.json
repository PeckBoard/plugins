{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeckBoard/plugins/schema/registry.schema.json",
  "title": "Peckboard Plugin Registry",
  "description": "Static index of installable Peckboard WASM plugins and bundled crate plugins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {
      "description": "Index format version. Bumped only on a breaking change to this schema.",
      "type": "integer",
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "crate_plugins": {
      "description": "Trusted plugins compiled into Peckboard. No url/sha256; they cannot be installed from the index.",
      "type": "array",
      "items": { "$ref": "#/$defs/cratePlugin" }
    },
    "mcp_servers": {
      "type": "array"
    }
  },
  "$defs": {
    "cratePlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "author", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-].+)?$"
        },
        "hooks": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
        },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "author", "version", "hooks", "url", "sha256"],
      "properties": {
        "id": {
          "description": "Stable plugin id. MUST equal the .wasm file stem Peckboard saves it under (e.g. `api` -> api.wasm), because a plugin's config and approval are keyed by that stem. Lowercase letters, digits, hyphen, underscore only.",
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "description": "Human-facing display name.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "description": "One- or two-sentence summary of what the plugin does.",
          "type": "string",
          "minLength": 1
        },
        "author": {
          "description": "Who publishes the plugin.",
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "description": "Optional source/docs URL.",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "version": {
          "description": "Semantic version of the published .wasm.",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-].+)?$"
        },
        "hooks": {
          "description": "Every hook the plugin declares — what the operator is asked to approve before it can run. Lowercase, dot-separated hook ids.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]*$"
          }
        },
        "url": {
          "description": "HTTPS download URL of the plugin .wasm (e.g. a GitHub release asset).",
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of the .wasm at `url`. Peckboard rejects the download if it doesn't match.",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "min_peckboard": {
          "description": "Optional minimum Peckboard version this plugin supports (semver).",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-].+)?$"
        },
        "permissions": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" }
      }
    }
  }
}
